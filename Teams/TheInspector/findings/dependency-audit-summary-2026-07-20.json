  "critical_findings": [
    {
      "id": "DEP-001",
      "title": "Handlebars.js Remote Code Execution",
      "package": "handlebars",
      "severity": "CRITICAL",
      "cvss_score": 9.8,
      "cve_ids": [
        "GHSA-2w6w-674q-4c4q",
        "GHSA-3mfm-83xf-c92r"
      ],
      "affected_modules": [
        "Source/Backend",
        "Source/Frontend",
        "portal/Backend",
        "portal/Frontend"
      ],
      "root_cause": "AST type confusion vulnerability allowing code injection via partial-block directives",
      "impact": "Remote code execution in Node.js context",
      "fix": "Upgrade to handlebars@>=4.7.9 or remove if not actively used",
      "action_required": true,
      "escalate_to": "TheGuardians"
    },
    {
      "id": "DEP-002",
      "title": "Vite Host Header Confusion",
      "package": "vite",
      "severity": "HIGH",
      "cvss_score": 7.1,
      "cve_ids": [
        "GHSA-3p3v-5vf6-f4q7"
      ],
      "affected_modules": [
        "Source/Frontend",
        "portal/Frontend"
      ],
      "root_cause": "Dev server does not validate Host header, allowing attacker-controlled hosts to serve assets",
      "impact": "Cache poisoning, CORS bypass, MitM",
      "fix": "Upgrade vite to >=5.4.3 and never expose dev server in production",
      "action_required": true
    },
    {
      "id": "DEP-003",
      "title": "Portal/Backend Observability Stack Bloat",
